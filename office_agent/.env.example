# Runtime model used by the DeepAgents binding. Defaults to DeepSeek Flash
# (deepseek-flash) served through DeepSeek's OpenAI-compatible endpoint.
# Aliases accepted by the Python settings: AGENTSEEK_MODEL, DEEPAGENTS_MODEL.
BUB_MODEL=openai:deepseek-flash

# Provider credentials: DeepSeek API key (https://platform.deepseek.com/api_keys).
# Aliases accepted by the Python settings: AGENTSEEK_API_KEY, OPENAI_API_KEY.
BUB_API_KEY=
# DeepSeek OpenAI-compatible base URL.
# Aliases accepted by the Python settings: AGENTSEEK_API_BASE, OPENAI_API_BASE, OPENAI_BASE_URL.
BUB_API_BASE=https://api.deepseek.com

# LangChain binding loaded by the Bub gateway.
BUB_LANGCHAIN_SPEC=office_agent.binding:build_spec

# AG-UI gateway bind port. The public service and health check URLs are
# declared in .agentseek/lifecycle.toml.
BUB_AG_UI_PORT=18088
BUB_STREAM_OUTPUT=true

# Root directory the office tools may read from and write to.
# Defaults to the working directory of the gateway process.
# OFFICE_AGENT_WORKSPACE=/absolute/path/to/workspace
